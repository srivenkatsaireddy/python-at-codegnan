   "source": [
    "n = input()\n",
    "vowel = 0\n",
    "consonant = 0\n",
    "for ch in n:\n",
    "    if ch in 'aeiou': \n",
    "        vowel += 1\n",
    "    else:\n",
    "        consonant = consonant + 1\n",
    "    \n",
    "print(\"VOWEL:\",vowel)\n",
    "print(\"CONSONANT:\", consonant)\n"
   ]
